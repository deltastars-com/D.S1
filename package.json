{
  "name": "delta-stars",
  "private": true,
  "version": "5.3.4",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/index.js",
    "start": "node dist/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && npm run preview",
    "build:prod": "vite build && esbuild server/_core/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "version:patch": "node scripts/update-version.js --patch",
    "version:minor": "node scripts/update-version.js --minor",
    "version:major": "node scripts/update-version.js --major",
    "version:show": "node -p \"require('./package.json').version\"",
    "sync": "npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build": "npm run build:netlify && npx cap sync",
    "build:netlify": "vite build",
    "build:vercel": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
